{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyConfiguration",
  "type": "object",
  "required": ["version", "adjudication", "memory"],
  "properties": {
    "version": {
      "type": "string"
    },
    "adjudication": {
      "type": "object",
      "required": ["min_independent"],
      "properties": {
        "min_independent": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "required": ["min_evidence_episodes"],
      "properties": {
        "min_evidence_episodes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
