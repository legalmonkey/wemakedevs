               n.procedure_id = 'proc-draft-notice', n.replayed = false,                   n.causal_path = $causal_path + [exp.ship_id, exp.rec_id]     ON MATCH SET n.replayed = true, n.action_type = coalesce(n.action_type, 'draft_notice'),                  n.causal_path = coalesce(n.causal_path, $causal_path + [exp.ship_id, exp.rec_id]) ) RETURN u.id AS unit_id, h.id AS hold_id, size([x IN exposures WHERE x.rec_id IS NOT NULL]) AS notices_created" "--compact"
