1792247002.914212 [0 172.18.0.1:50274] "GRAPH.QUERY" "g_tenant_alpha" "CYPHER `unit_id`=\"batchlot_4812_22c413df\" `hold_id`=\"act-hold-batchlot_4812_22c413df\" `causal_path`=[\"sensorlog_4812_ad27d585\",\"qualitydecision_4812_91813ac4\",\"batchlot_4812_22c413df\"] MATCH (u:Unit {id: $unit_id}) WHERE (coalesce(u.is_tainted, false) = true OR coalesce(u.verdict, '') = 'tainted')   AND coalesce(u.verdict, '') <> 'reaffirmed'   AND coalesce(u.status, '') <> 'reaffirmed' SET u.status = 'quarantined', u.hold_placed = true, u.verdict = 'tainted',     u.taint_via_path = coalesce(u.taint_via_path, $causal_path),     u.taint_hops = coalesce(u.taint_hops, size($causal_path) - 1),     u.is_tainted = true MERGE (h:Action {id: $hold_id}) ON CREATE SET h.kind = 'hold_unit', h.action_kind = 'hold_unit', h.action_type = 'hold_unit', h.role = 'Action',               h.target_entity_id = u.id, h.causal_path = $causal_path,               h.requires_approval = false, h.reason_code = 'TAINT_CONFIRMED',               h.procedure_id = 'proc-hold-unit', h.replayed = false ON MATCH SET h.replayed = true, h.action_type = coalesce(h.action_type, 'hold_unit'),              h.causal_path = coalesce(h.causal_path, $causal_path) WITH u, h OPTIONAL MATCH (u)-[r1]->(s:Shipment)-[r2]->(r:Recipient) WHERE (r1.role = 'ships-in' OR type(r1) IN ['SHIPS_IN', 'ships-in'])   AND (r2.role = 'delivered-to' OR type(r2) IN ['DELIVERED_TO', 'delivered-to']) WITH u, h, collect(DISTINCT {rec_id: r.id, ship_id: s.id}) AS exposures FOREACH (exp IN [x IN exposures WHERE x.rec_id IS NOT NULL] |     MERGE (n:Action {id: 'act-notice-' + exp.rec_id + '-' + u.id})     ON CREATE SET n.kind = 'draft_notice', n.action_kind = 'draft_notice', n.action_type = 'draft_notice', n.role = 'Action',                   n.target_entity_id = exp.rec_id, n.requires_approval = true,                   n.reason_code = 'EXPOSURE_DETECTED', n.unit_id = u.id,                   n.shipment_id = exp.ship_id, n.status = 'pending_approval',                   n.procedure_id = 'proc-draft-notice', n.replayed = false,                   n.causal_path = $causal_path + [exp.ship_id, exp.rec_id]     ON MATCH SET n.replayed = true, n.action_type = coalesce(n.action_type, 'draft_notice'),                  n.causal_path = coalesce(n.causal_path, $causal_path + [exp.ship_id, exp.rec_id]) ) RETURN u.id AS unit_id, h.id AS hold_id, size([x IN exposures WHERE x.rec_id IS NOT NULL]) AS notices_created" "--compact"
